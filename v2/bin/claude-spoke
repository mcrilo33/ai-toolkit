#!/usr/bin/env bash
# Claude Code launcher for spokes. In a spoke worktree (.ai-toolkit/spoke-run-id, written by
# setup.sh) it exports Claude's native OTel to the collector with a spoke_run_id resource
# attribute, then execs the real claude. Anywhere else it is a plain claude, so it is safe to
# point Orca's agentCmdOverrides.claude at it. AI_TOOLKIT_OTEL=0 opts out. No auth header here.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck source=../scripts/lib.sh
. "$here/../scripts/lib.sh"

real="${CLAUDE_REAL:-$(command -v claude || true)}"   # the real binary: this script is not named `claude`
[ -n "$real" ] || die "no claude found on PATH"
[ ! "$real" -ef "${BASH_SOURCE[0]}" ] || die "claude resolves to this script: set CLAUDE_REAL"

top="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
if [ "${AI_TOOLKIT_OTEL:-1}" = 1 ] && [ -s "$top/.ai-toolkit/spoke-run-id" ]; then
  load_env
  repo="$(git remote get-url origin 2>/dev/null | sed -E 's#.*[/:]##; s#\.git$##' || true)"
  id="$(cat "$top/.ai-toolkit/spoke-run-id")"
  export CLAUDE_CODE_ENABLE_TELEMETRY=1 CLAUDE_CODE_ENHANCED_TELEMETRY_BETA=1 ENABLE_BETA_TRACING_DETAILED=1
  export OTEL_TRACES_EXPORTER=otlp OTEL_METRICS_EXPORTER=otlp OTEL_LOGS_EXPORTER=otlp OTEL_EXPORTER_OTLP_PROTOCOL=grpc
  export OTEL_LOG_USER_PROMPTS=1 OTEL_LOG_TOOL_DETAILS=1 OTEL_LOG_TOOL_CONTENT=1 OTEL_METRICS_INCLUDE_ACCOUNT_UUID=false
  export OTEL_EXPORTER_OTLP_ENDPOINT="${OTEL_ENDPOINT:-http://localhost:4317}"
  export BETA_TRACING_ENDPOINT="${OTEL_BETA_ENDPOINT:-http://localhost:4418}"
  export OTEL_RESOURCE_ATTRIBUTES="spoke_run_id=$id${repo:+,repo=$repo}"
fi
exec "$real" "$@"
