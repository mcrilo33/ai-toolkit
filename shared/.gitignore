# Environment
.env
.env.*
!.env.example

# IDE
.idea/
.vscode/
*.swp
*.swo

# Dependencies
node_modules/
venv/
.venv/
__pycache__/
*.pyc

# Build artifacts
dist/
build/
*.egg-info/
.cache/

# OS
.DS_Store
Thumbs.db

# Secrets (never commit)
*.pem
*.key
*credentials*
*secret*

# Exception: hook *source* scripts whose names legitimately contain "secret"
# (the secrets-scan family). These are code, not credentials, and must be
# tracked so the hook pipeline can sync them. The broad *secret* rule above
# still guards every other path.
!hooks/secrets-scan.sh
!hooks/secrets-scan-revert.sh
