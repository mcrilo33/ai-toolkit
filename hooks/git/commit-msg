#!/usr/bin/env bash
# commit-msg: a conventional type on line 1 and an issue anchor (#N) in the message; only a test: commit may change a test file (TEST_PATHS globs).
# Merge/revert/fixup commits skip the type and anchor check; a fixup is judged by the type it targets. 'Test-Change: <why>' lets one commit through. land.sh reuses the test-file rule on pushed commits: 'commit-msg --check <msgfile>' with 'git diff --name-status -M' lines on stdin.
set -euo pipefail
chk=0; [ "${1:-}" != --check ] || { chk=1; shift; }
msg="$(grep -vE '^#([[:space:]]|$)' "$1" || true)" # drop the editor's comment lines
first="$(printf '%s\n' "$msg" | head -n 1)"; sub="$first"; fx='^(fixup|squash|amend)! (.*)'
case "$chk$first" in 0Merge\ * | ?Revert\ *) exit 0 ;; esac   # land.sh skips real merges by parent count, so a --check "Merge" subject is judged
[[ $first =~ $fx ]] && sub="${BASH_REMATCH[2]}"
re='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([A-Za-z0-9._/-]+\))?!?: .+'
if [ "$chk$sub" = "0$first" ]; then
  [[ $first =~ $re ]] || { echo "commit-msg: line 1 must be '<type>(<scope>): <subject>', type in feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert" >&2; exit 1; }
  [[ $msg =~ \#[0-9]+ ]] || { echo "commit-msg: add the issue anchor, e.g. 'Refs #123' (or '(#123)' in the subject)" >&2; exit 1; }
fi
type="${sub%%[(:!]*}"; [ "$type" != test ] && [ "$type" != revert ] || exit 0
if [ -z "${TEST_PATHS+x}" ]; then # caller env > local env > shipped default; no lib.sh here, so the key is read by hand
  hd="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
  for f in "${AI_TOOLKIT_LOCAL_ENV:-$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")/.ai-toolkit/ai-toolkit.local.env}" "${AI_TOOLKIT_ENV:-$hd/../../settings/ai-toolkit.env}" "$hd/../../ai-toolkit.env"; do
    v="$(grep -m1 '^TEST_PATHS=' "$f" 2> /dev/null || true)"; [ -z "$v" ] || { v="${v#*=}"; TEST_PATHS="${v//\"/}"; break; }
  done
fi
[ -n "${TEST_PATHS+x}" ] || { echo "commit-msg: TEST_PATHS is set nowhere: the test-file check is off" >&2; exit 0; }
[ -n "${TEST_PATHS// /}" ] || exit 0 # an explicit empty value turns the check off
set -f; read -ra globs <<< "$TEST_PATHS"; bad=""
while IFS= read -r p; do # '*' spans '/', and a leading '**/' also matches at the repo root
  for g in "${globs[@]}"; do [[ $p == $g || $p == ${g#\*\*/} ]] && { bad+=" $p"; break; }; done
done < <({ if [ "$chk" = 1 ]; then cat; else git -c core.quotePath=false diff --cached --name-status -M; fi; } | cut -f2- | tr '\t' '\n')
[ -n "$bad" ] || exit 0
printf '%s\n' "$msg" | grep -qE '^Test-Change: .*[^[:space:]]' && { echo "commit-msg: Test-Change commit touches test files:$bad" >&2; exit 0; }
echo "commit-msg: only a test: commit may change test files:$bad; split the test change into its own 'test(<scope>): ... #<n>' commit (or add a 'Test-Change: <why>' line)" >&2; exit 1
