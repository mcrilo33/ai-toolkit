# ai-toolkit v2 settings: flat KEY=value (optionally "quoted"), no inline comments, no export.
# Sourced by bash (scripts/lib.sh load_env) and read by Python. Precedence: caller env >
# .ai-toolkit/ai-toolkit.local.env (gitignored, per machine/target) > this file.
SPOKE_MODEL=claude-sonnet-5-5
SPOKE_EFFORT=high
REVIEW_MODEL=claude-opus-5-5
ANSWER_MODEL=claude-opus-5-5
BASE_BRANCH=main
CHECK_CMD="pytest -n auto tests"
CONCURRENCY_CAP=3
GATE_DEFAULT=plan
# 1 = land.sh gates with CHECK_CMD in the spoke instead of CI (until ci.yml exists on the branch; D7).
LOCAL_GATE=0
ORCA_MIN_VERSION=1.4.218
# owner/repo where tooling defects found in a synced project are filed; sync.sh sets it in a host, empty only in the toolkit itself.
UPSTREAM_REPO=
# Where the toolkit checkout is: sync.sh sets it (in the toolkit itself, its own path). With AUTO_SYNC=1 the coordinator loop syncs its project when that checkout is ahead of
# the installed toolkit-version and then re-executes itself; AUTO_SYNC=0 in .ai-toolkit/ai-toolkit.local.env keeps a project manual.
TOOLKIT_DIR=
AUTO_SYNC=1
# The loop picks and dispatches only open issues carrying this label, and files its own issues with it: on by default, so a repo where others file issues is never dispatched from.
# DISPATCH_LABEL= (empty) in .ai-toolkit/ai-toolkit.local.env opts out: every issue is picked.
DISPATCH_LABEL=ai-toolkit
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
# Native OTel export of a spoke (bin/claude-spoke). gRPC and the beta-tracing HTTP port are
# distinct on purpose: a beta endpoint on the normal port silently kills all trace export.
OTEL_ENDPOINT=http://localhost:4317
OTEL_BETA_ENDPOINT=http://localhost:4418
