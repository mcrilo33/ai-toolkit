# Environment
.env
.env.*
!.env.example

# IDE
.idea/
.vscode/
.claude/
.cursor/
# Ignore synced Copilot configs but keep this repo's own CI workflows tracked
.github/*
!.github/workflows/
*.swp
*.swo

# Python
.venv/
venv/
__pycache__/
*.pyc
.coverage
htmlcov/
*.egg-info/
uv.lock

# Build artifacts
dist/

# AI-toolkit local state (regenerated by sync / review-stamp)
.ai-toolkit-manifest.json
.ai-toolkit/
.review/

# OS
.DS_Store
Thumbs.db

# Secrets (never commit)
*.pem
*.key

# Local placeholders (not yet handled by sync-to-repo.sh) — except the
# declarative toolkit config, which IS a tracked source of truth read by the
# sync pipeline (issue #142). Ignore settings/* (not settings/) so a specific
# file can be re-included: git cannot un-ignore a file under an ignored dir.
settings/*
!settings/ai-toolkit.yml
