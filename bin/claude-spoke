#!/usr/bin/env bash
# Claude Code launcher. In a project synced by ai-toolkit it passes the toolkit's guards (--settings, below). In a spoke worktree (.ai-toolkit/spoke-run-id,
# written by setup.sh) it also exports Claude's native OTel to the collector with a spoke_run_id resource attribute, then execs the real claude. In an unsynced
# project it is a plain claude, so it is safe to point Orca's agentCmdOverrides.claude at it. AI_TOOLKIT_OTEL=0 opts out of the OTel. No auth header here.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck source=../scripts/lib.sh
. "$here/../scripts/lib.sh"

real="${CLAUDE_REAL:-$(command -v claude || true)}"   # the real binary: this script is not named `claude`
[ -n "$real" ] || die "no claude found on PATH"
[ ! "$real" -ef "${BASH_SOURCE[0]}" ] || die "claude resolves to this script: set CLAUDE_REAL"

top="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
# The toolkit's guards: the hook registrations of the project this session starts in (a worker's worktree resolves to its main checkout through the common git dir),
# passed with --settings, so the project's own settings cannot replace or switch them off. Orca's Claude command is one path for every project: an unsynced project
# gets plain claude; a worker with no file is refused, never started without guards. A second --settings would silently drop the first (the last wins): refused too.
tk="$(dirname "$(git rev-parse --path-format=absolute --git-common-dir 2> /dev/null || echo "$top/.git")")/.ai-toolkit"
if [ -f "$tk/claude-settings.json" ]; then
  for a in "$@"; do case "$a" in --settings | --settings=*) die "the launcher owns --settings (the toolkit's guards): do not pass one" ;; esac; done
  AI_TOOLKIT_DIR="$(cd "$tk" && pwd -P)"; export AI_TOOLKIT_DIR   # the hooks run from here, and /coordinate reads it to know its session has the guards
  set -- --settings "$AI_TOOLKIT_DIR/claude-settings.json" "$@"
elif [ -s "$top/.ai-toolkit/spoke-run-id" ]; then die "no $tk/claude-settings.json: sync ai-toolkit into the main checkout, a worker never starts without its guards"; fi
if [ "${AI_TOOLKIT_OTEL:-1}" = 1 ] && [ -s "$top/.ai-toolkit/spoke-run-id" ]; then
  load_env
  repo="$(git remote get-url origin 2>/dev/null | sed -E 's#.*[/:]##; s#\.git$##' || true)"
  id="$(cat "$top/.ai-toolkit/spoke-run-id")"
  export CLAUDE_CODE_ENABLE_TELEMETRY=1 CLAUDE_CODE_ENHANCED_TELEMETRY_BETA=1 ENABLE_BETA_TRACING_DETAILED=1
  export OTEL_TRACES_EXPORTER=otlp OTEL_METRICS_EXPORTER=otlp OTEL_LOGS_EXPORTER=otlp OTEL_EXPORTER_OTLP_PROTOCOL=grpc
  export OTEL_LOG_USER_PROMPTS=1 OTEL_LOG_TOOL_DETAILS=1 OTEL_LOG_TOOL_CONTENT=1 OTEL_METRICS_INCLUDE_ACCOUNT_UUID=false
  export OTEL_EXPORTER_OTLP_ENDPOINT="${OTEL_ENDPOINT:-http://localhost:4317}"
  export BETA_TRACING_ENDPOINT="${OTEL_BETA_ENDPOINT:-http://localhost:4418}"
  export OTEL_RESOURCE_ATTRIBUTES="spoke_run_id=$id${repo:+,repo=$repo}"
fi
exec "$real" "$@"
