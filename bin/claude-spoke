#!/usr/bin/env bash
# Claude Code launcher. In a project synced by ai-toolkit it passes the toolkit's guards (--settings, below). In a spoke worktree (.ai-toolkit/spoke-run-id,
# written by setup.sh) it also limits MCP to the toolkit's list (.ai-toolkit/mcp.json), then execs the real claude. In a synced project it exports Claude's native OTel to the collector:
# a worker with a spoke_run_id resource attribute, any other session (the coordinator or hub session on the main checkout) with role=coordinator and no run id or issue; a headless claude -p it spawns inherits the tag.
# Privacy: with the OTEL_LOG_* opt-ins below, the raw JSONL the collector keeps (AITK_OTEL_RAW_DIR, 1.1 GB / 30 days) holds prompts and tool output in plaintext,
# a coordinator's too, which include the human's own messages. Remote Control is split the same way as the notifications: off for a worker, on for the coordinator. In an unsynced project it is a plain claude, so it is safe to point Orca's agentCmdOverrides.claude at it.
# AI_TOOLKIT_OTEL=0 opts out of the OTel. No auth header on the OTel exporter.
# Claude account (#556): the project's CLAUDE_ACCOUNTS (per machine, ai-toolkit.local.env) lists the accounts it may use, the first being the default; --account <name> picks another listed one (the loop names it on a worker's launch line).
# The stored login of ~/.claude (CLAUDE_STORED_ACCOUNT, default max) exports nothing. A name with a directory ~/.claude-<name> runs on that full login (CLAUDE_CONFIG_DIR, sharing the user's settings, skills and memory by symlink). Any other name
# is a long-lived token (claude setup-token) in the Keychain service CLAUDE_OAUTH_TOKEN_<NAME>, read here and exported only as CLAUDE_CODE_OAUTH_TOKEN (Claude itself withholds it from the hooks it starts, measured on 2.1.331: CLAUDE_CODE_SUBPROCESS_ENV_SCRUB=1 is NOT set, it would also drop SSH_AUTH_SOCK, GIT_ASKPASS and the cloud credentials a worker pushes with).
# Never in argv, a log or OTEL_*; no fallback to another account. A name the project does not list is refused. Inherited ANTHROPIC_API_KEY / ANTHROPIC_AUTH_TOKEN, which outrank every login, are unset so the chosen account is the one used.
# To use Orca's Chat UI, put --settings ai-toolkit in Orca's Claude arguments: the launcher swaps it for the project's guard file (Orca's own --settings would switch every hook off).
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck source=../scripts/lib.sh
. "$here/../scripts/lib.sh"

real="${CLAUDE_REAL:-$(command -v claude || true)}"   # the real binary: this script is not named `claude`
[ -n "$real" ] || die "no claude found on PATH"
[ ! "$real" -ef "${BASH_SOURCE[0]}" ] || die "claude resolves to this script: set CLAUDE_REAL"

top="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
# The toolkit's guards: the hook registrations of the project this session starts in (a worker's worktree resolves to its main checkout through the common git dir),
# passed with --settings, so the project's own settings cannot replace or switch them off. Orca's Claude command is one path for every project: an unsynced project
# gets plain claude; a worker with no file is refused, never started without guards. A second --settings would silently drop the first (the last wins): refused too.
tk="$(dirname "$(git rev-parse --path-format=absolute --git-common-dir 2> /dev/null || echo "$top/.git")")/.ai-toolkit"
kept=(); account=""; named=""   # drop the sentinel (the saved Claude arguments are global, the guard file is per project) and --account (the launcher's own): the checks below see only what is left
while [ $# -gt 0 ]; do
  if [ "$1" = --settings=ai-toolkit ]; then shift; elif [ "$1" = --settings ] && [ "${2:-}" = ai-toolkit ]; then shift 2
  elif [ "$1" = --account ]; then [ $# -ge 2 ] || die "--account needs a name"; account="$2"; named=1; shift 2
  elif [[ $1 == --account=* ]]; then account="${1#--account=}"; named=1; shift
  else kept+=("$1"); shift; fi
done
set -- ${kept[@]+"${kept[@]}"}
if [ -f "$tk/claude-settings.json" ]; then
  jq -e '.disableAllHooks == false and ((.hooks.PreToolUse // []) | length) > 0' "$tk/claude-settings.json" > /dev/null 2>&1 \
    || die "$tk/claude-settings.json is unreadable or does not register the guards (disableAllHooks false, PreToolUse hooks): sync ai-toolkit again, never a session without them"
  for a in "$@"; do case "$a" in --settings | --settings=*) die "the launcher owns --settings (the toolkit's guards): do not pass one" ;; esac; done
  AI_TOOLKIT_DIR="$(cd "$tk" && pwd -P)"; export AI_TOOLKIT_DIR   # the hooks run from here, and /coordinate reads it to know its session has the guards
  s="$AI_TOOLKIT_DIR/claude-settings.json"
  # the same file goes inline (--settings takes a file or JSON), one Remote Control value per role. A worker pins it off (even when the user's own settings turn it on) and has Claude's own notifications off,
  # since only the coordinator alerts the human. Any other session in a synced project (the coordinator or hub) turns it on so its PushNotification reaches the phone (repo settings cannot enable it, inline ones can)
  if [ -s "$top/.ai-toolkit/spoke-run-id" ]; then s="$(jq -c '. + {preferredNotifChannel: "notifications_disabled", remoteControlAtStartup: false}' "$s")"
  else s="$(jq -c '. + {remoteControlAtStartup: true}' "$s")"; fi
  set -- --settings "$s" "$@"
elif [ -s "$top/.ai-toolkit/spoke-run-id" ]; then die "no $tk/claude-settings.json: sync ai-toolkit into the main checkout, a worker never starts without its guards"
else unset AI_TOOLKIT_DIR; fi   # an inherited one would tell /coordinate this session has guards it does not have
if [ -s "$top/.ai-toolkit/spoke-run-id" ]; then   # a worker has only the servers on the toolkit's list (plus the host's own mcp.local.json), never the human's connectors, and no Chrome
  for a in "$@"; do case "$a" in --mcp-config | --mcp-config=* | --strict-mcp-config | --chrome) die "the launcher owns the MCP servers (.ai-toolkit/mcp.json, no Chrome): do not pass $a" ;; esac; done
  lists=("$AI_TOOLKIT_DIR/mcp.json")
  [ ! -f "$AI_TOOLKIT_DIR/mcp.local.json" ] || lists+=("$AI_TOOLKIT_DIR/mcp.local.json")
  mcp=()
  for f in "${lists[@]}"; do
    jq -e '(.mcpServers | type) == "object"' "$f" > /dev/null 2>&1 \
      || die "$f is missing or is not {\"mcpServers\": {...}}: sync ai-toolkit again (mcp.local.json is the host's own: fix or remove it), a worker never starts with every MCP server"
    mcp+=(--mcp-config "$f")
  done
  set -- --strict-mcp-config "${mcp[@]}" --no-chrome "$@"
fi
synced=""; if [ -s "$top/.ai-toolkit/spoke-run-id" ] || [ -f "$tk/claude-settings.json" ]; then synced=1; load_env; fi   # a worker, or a session in a synced project that is not one: a coordinator or hub session by construction
tag=""; cfg=""
if [ -n "$synced" ] && { [ -n "${CLAUDE_ACCOUNTS:-}" ] || [ -n "$named" ]; }; then
  [ -n "$named" ] || account="$(first_account)"
  valid_account "$account" || die "'$account' is not an account name (letters, digits, _ and - only)"
  account_listed "$account" || die "account '$account' is not listed in CLAUDE_ACCOUNTS (${CLAUDE_ACCOUNTS:-empty}): this project may not use it"
  # the choice of the auth env, once, here: the stored login exports nothing; a directory ~/.claude-<name> is its own full login; anything else is a Keychain token
  unset CLAUDE_CODE_OAUTH_TOKEN CLAUDE_CONFIG_DIR ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN CLAUDE_SECURESTORAGE_CONFIG_DIR ANTHROPIC_PROFILE ANTHROPIC_CONFIG_DIR ANTHROPIC_BASE_URL ANTHROPIC_CUSTOM_HEADERS \
    CLAUDE_CODE_OAUTH_TOKEN_FILE_DESCRIPTOR CLAUDE_CODE_OAUTH_REFRESH_TOKEN CLAUDE_CODE_USE_BEDROCK CLAUDE_CODE_USE_VERTEX CLAUDE_CODE_USE_FOUNDRY   # whatever in the caller's env would decide whose login Claude uses
  cfg="$HOME/.claude-$account"
  if [ "$account" = "${CLAUDE_STORED_ACCOUNT:-max}" ]; then cfg=""
  elif [ -d "$cfg" ]; then
    jq -e '.oauthAccount | type == "object"' "$cfg/.claude.json" > /dev/null 2>&1 || die "no login in $cfg: run CLAUDE_CONFIG_DIR=$cfg claude auth login"
    for n in settings.json CLAUDE.md skills agents commands hooks plugins projects; do   # what the account shares with ~/.claude, by link, only where the directory has nothing of its own
      [ -e "$HOME/.claude/$n" ] || continue
      [ "$(readlink "$cfg/$n" 2> /dev/null)" != "$HOME/.claude/$n" ] || continue
      if [ -e "$cfg/$n" ] || [ -L "$cfg/$n" ]; then warn "$cfg/$n is not a link to ~/.claude/$n: kept, so account $account does not share it"; else ln -sn "$HOME/.claude/$n" "$cfg/$n" 2> /dev/null || [ "$(readlink "$cfg/$n" 2> /dev/null)" = "$HOME/.claude/$n" ] || die "cannot link $cfg/$n"; fi   # -n: two launches may start together, and the loser must not link inside the winner's link (that would write into ~/.claude)
    done
    export CLAUDE_CONFIG_DIR="$cfg"
  else
    svc="CLAUDE_OAUTH_TOKEN_$(printf %s "$account" | LC_ALL=C tr 'a-z-' 'A-Z_')"; cfg=""
    tok="$("${AITK_SECURITY:-/usr/bin/security}" find-generic-password -s "$svc" -w 2> /dev/null)" && [ -n "$tok" ] || die "no Keychain item $svc for account $account (claude setup-token, then security add-generic-password -s $svc): no other account is used instead"
    export CLAUDE_CODE_OAUTH_TOKEN="$tok"; unset tok
  fi
  if multi_account; then tag=",account=$account"; fi
  if [ -n "$cfg" ] && [ ! -s "$top/.ai-toolkit/spoke-run-id" ] && [ -f "$HOME/.claude.json" ]; then   # the user-scope MCP servers live in ~/.claude.json, which a config directory does not read: a session of the human gets them from here (a worker has only the toolkit's list).
    # A file, not a process substitution: the fd does not survive the `exec` below. It is a mode-0600 copy of what ~/.claude.json already holds, rewritten at each start (a revoked key stays in it until then).
    (umask 077; t="$(mktemp "$cfg/aitk-user-mcp.XXXXXX")" && jq -c '{mcpServers: (.mcpServers // {})}' "$HOME/.claude.json" > "$t" && mv "$t" "$cfg/aitk-user-mcp.json") || die "cannot write $cfg/aitk-user-mcp.json"
    set -- --mcp-config "$cfg/aitk-user-mcp.json" "$@"
  fi
elif [ -n "$named" ]; then die "account '$account' is not listed in CLAUDE_ACCOUNTS: this project is not synced, so no account is used"; fi
if [ "${AI_TOOLKIT_OTEL:-1}" = 1 ] && [ -n "$synced" ]; then
  repo="$(git remote get-url origin 2>/dev/null | sed -E 's#.*[/:]##; s#\.git$##' || true)"
  if [ -s "$top/.ai-toolkit/spoke-run-id" ]; then
    who="spoke_run_id=$(cat "$top/.ai-toolkit/spoke-run-id")"
    issue="$(sed -nE '1s/^# #([0-9]+)( .*)?$/\1/p' "$top/.ai-toolkit/task.md" 2> /dev/null || true)"   # a telemetry label only: no file, or a first line that is not "# #<n> ...", leaves it out
  else who="role=coordinator"; issue=""; fi
  tv="$(head -c 64 "$tk/toolkit-version" 2> /dev/null || true)"   # data in the target: only a whole-content hex sha (+ -dirty) goes into the attribute list, never a "," or "="
  [[ "$tv" =~ ^[0-9a-f]{7,40}(-dirty)?$ ]] || tv=""
  export CLAUDE_CODE_ENABLE_TELEMETRY=1 CLAUDE_CODE_ENHANCED_TELEMETRY_BETA=1 ENABLE_BETA_TRACING_DETAILED=1
  export OTEL_TRACES_EXPORTER=otlp OTEL_METRICS_EXPORTER=otlp OTEL_LOGS_EXPORTER=otlp OTEL_EXPORTER_OTLP_PROTOCOL=grpc
  export OTEL_LOG_USER_PROMPTS=1 OTEL_LOG_TOOL_DETAILS=1 OTEL_LOG_TOOL_CONTENT=1 OTEL_METRICS_INCLUDE_ACCOUNT_UUID=false
  export OTEL_EXPORTER_OTLP_ENDPOINT="${OTEL_ENDPOINT:-http://localhost:4317}"
  export BETA_TRACING_ENDPOINT="${OTEL_BETA_ENDPOINT:-http://localhost:4418}"
  export OTEL_RESOURCE_ATTRIBUTES="$who${repo:+,repo=$repo}${issue:+,issue=$issue}${tv:+,toolkit_version=$tv}$tag"
fi
exec "$real" "$@"
